{
  "name": "dailyhire-functions",
  "version": "1.0.0",
  "private": true,
  "description": "DailyHire secure Firebase backend",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "test": "vitest run",
    "deploy": "npm run build && firebase deploy --only functions,firestore,storage"
  },
  "dependencies": {
    "firebase-admin": "13.0.0",
    "firebase-functions": "6.2.0",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
